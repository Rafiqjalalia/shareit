# ==========================================
# ShaeIt Environment Variables
# ==========================================

# 1. Base Application URL (Optional, defaults to window.location.origin)
# NEXT_PUBLIC_APP_URL="https://shareit-olive.vercel.app"

# 2. Serverless Database Store (Upstash Redis via Vercel Marketplace or upstash.com)
# Used for temporary link tracking (opens, downloads, timestamps) with native key TTL.
UPSTASH_REDIS_REST_URL="https://xxxx-xxxx-xxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXXXAAIncDFxxxxxxx..."

# Alternative Vercel KV environment variables (auto-populated if using Vercel KV storage integration)
# KV_REST_API_URL="https://xxxx-xxxx-xxxxx.upstash.io"
# KV_REST_API_TOKEN="AXXXAAIncDFxxxxxxx..."

# 3. Realtime Messaging (Pusher / Ably for Feature 2 Quick Paste)
# PUSHER_APP_ID="xxxxxxx"
# NEXT_PUBLIC_PUSHER_KEY="xxxxxxx"
# PUSHER_SECRET="xxxxxxx"
# NEXT_PUBLIC_PUSHER_CLUSTER="us2"
